// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // Remove any "output = ..." line if it exists
}

datasource db {
  provider = "postgresql"
}

model Company {
  ticker      String  @id
  name        String
  description String?
  sector      String?
  industry    String?
  exchange    String?
  website     String?
  logoUrl     String?
  ceo         String?
  ipoDate     String?

  financials CompanyFinancial[]
}

enum StatementType {
  income
  balance_sheet
  cash_flow
}

enum PeriodType {
  annual
  quarterly
}

model CompanyFinancial {
  ticker        String
  statementType StatementType
  fiscalYear    Int
  periodType    PeriodType
  quarter       Int // 0 = annual, 1-4 = quarterly

  fiscalDateEnding DateTime?
  reportedCurrency String?
  payload          Json

  company Company @relation(fields: [ticker], references: [ticker], onDelete: Cascade)

  @@id([ticker, statementType, fiscalYear, periodType, quarter])
  @@index([ticker, statementType, periodType, fiscalYear])
}


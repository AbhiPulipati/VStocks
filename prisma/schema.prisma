generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  ticker      String             @id
  name        String
  description String?
  sector      String?
  industry    String?
  website     String?
  logoUrl     String?
  exchange    String?
  ceo         String?
  ipoDate     String?
  financials  CompanyFinancial[]
}

model CompanyFinancial {
  ticker           String
  statementType    StatementType
  fiscalYear       Int
  periodType       PeriodType
  quarter          Int
  fiscalDateEnding DateTime?
  reportedCurrency String?
  payload          Json
  company          Company       @relation(fields: [ticker], references: [ticker], onDelete: Cascade)

  @@id([ticker, statementType, fiscalYear, periodType, quarter])
  @@index([ticker, statementType, periodType, fiscalYear])
}

enum StatementType {
  income
  balance_sheet
  cash_flow
}

enum PeriodType {
  annual
  quarterly
}
